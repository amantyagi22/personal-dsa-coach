# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit it.

# Required. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The stronger model. Used for problem analysis and grading review answers,
# where quality matters and the free-tier request budget is small.
GEMINI_MODEL_REASONING=gemini-2.5-pro

# The cheaper, faster model. Used for the agent loop, `ask`, and recommendation
# prose - anything run often enough that the reasoning model's quota would run out.
GEMINI_MODEL_FAST=gemini-2.5-flash

# Optional. Only needed by `sync` to import your LeetCode submission history.
#
# WARNING: this cookie is full access to your LeetCode account. Anyone holding it
# is logged in as you. Keep it here and nowhere else. It expires every couple of
# weeks - paste a fresh one when `sync` starts failing.
LEETCODE_SESSION=

# Where the local SQLite database lives.
DATABASE_PATH=data/coach.db
